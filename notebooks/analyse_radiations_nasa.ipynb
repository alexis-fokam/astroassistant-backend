    "# Chargement des événements à particules solaires (SEP) DONKI pendant la croisière\n",
    "sep_rows = []\n",
    "for json_file in sorted((DATA_DIR / \"donki\").glob(\"sep_*.json\")):\n",
    "    for event in json.loads(json_file.read_text(encoding=\"utf-8\")):\n",
    "        sep_rows.append({\"sep_id\": event[\"sepID\"], \"debut\": event[\"eventTime\"]})\n",
    "df_sep = pd.DataFrame(sep_rows).drop_duplicates(\"sep_id\")\n",
    "df_sep[\"debut\"] = pd.to_datetime(df_sep[\"debut\"], utc=True)\n",
    "debut_croisiere, fin_croisiere = df_rad[\"utc\"].min(), df_rad[\"utc\"].max()\n",
    "sep_croisiere = df_sep[(df_sep[\"debut\"] >= debut_croisiere) & (df_sep[\"debut\"] <= fin_croisiere)]\n",
    "sep_croisiere = sep_croisiere.sort_values(\"debut\")\n",
    "print(f\"SEP catalogués par la NASA pendant la croisière : {len(sep_croisiere)}\")\n",
    "\n",
    "# Épisodes de pics RAD : jours au-dessus du seuil, regroupés s'ils sont espacés de moins de 4 jours\n",
    "jours_pics = sorted(pics_solaires[\"utc\"].dt.normalize().unique())\n",
    "episodes = []\n",
    "for jour in jours_pics:\n",
    "    if episodes and (jour - episodes[-1][-1]) <= pd.Timedelta(days=4):\n",
    "        episodes[-1].append(jour)\n",
    "    else:\n",
    "        episodes.append([jour])\n",
    "\n",
    "lignes = []\n",
    "for jours in episodes:\n",
    "    fenetre = df_rad[\n",
    "        (df_rad[\"utc\"] >= jours[0]) & (df_rad[\"utc\"] < jours[-1] + pd.Timedelta(days=1))\n",
    "    ]\n",
    "    pic = fenetre.loc[fenetre[\"dose_msv_day\"].idxmax()]\n",
    "    # Un SEP explique le pic s'il a commencé au plus 3 jours avant (propagation et durée de l'événement)\n",
    "    candidats = sep_croisiere[\n",
    "        (sep_croisiere[\"debut\"] <= pic[\"utc\"])\n",
    "        & (sep_croisiere[\"debut\"] >= pic[\"utc\"] - pd.Timedelta(days=3))\n",
    "    ]\n",
    "    lignes.append(\n",
    "        {\n",
    "            \"debut_episode\": jours[0].date(),\n",
    "            \"pic_utc\": pic[\"utc\"].strftime(\"%Y-%m-%d %H:%M\"),\n",
    "            \"pic_msv_jour\": round(pic[\"dose_msv_day\"], 2),\n",
    "            \"sep_nasa\": \", \".join(candidats[\"sep_id\"].str[:16]) or \"aucun\",\n",
    "        }\n",
    "    )\n",
    "df_episodes = pd.DataFrame(lignes)\n",
    "expliques = int((df_episodes[\"sep_nasa\"] != \"aucun\").sum())\n",
    "print(\n",
    "    f\"Épisodes de pics RAD : {len(df_episodes)}, dont {expliques} précédés d'un SEP NASA \"\n",
    "    f\"({expliques / len(df_episodes):.0%})\"\n",
    ")\n",
    "display(df_episodes)\n",
    "\n",
    "# Courbe RAD avec les débuts des SEP en surimpression\n",
    "fig, ax = plt.subplots(figsize=(14, 5))\n",
    "ax.plot(\n",
    "    df_rad[\"utc\"],\n",
    "    df_rad[\"dose_msv_day\"],\n",
    "    color=\"#1f77b4\",\n",
    "    lw=0.8,\n",
    "    label=\"Débit de dose RAD (mSv/jour)\",\n",
    ")\n",
    "for i, debut in enumerate(sep_croisiere[\"debut\"]):\n",
    "    ax.axvline(\n",
    "        debut,\n",
    "        color=\"#d62728\",\n",
    "        alpha=0.35,\n",
    "        lw=1,\n",
    "        label=\"Début d'un SEP (NASA DONKI)\" if i == 0 else None,\n",
    "    )\n",
    "ax.set_yscale(\"log\")\n",
    "ax.set_title(\n",
    "    \"Curiosity RAD vs événements à particules solaires catalogués par la NASA\", fontweight=\"bold\"\n",
    ")\n",
    "ax.set_xlabel(\"Date (UTC)\")\n",
    "ax.set_ylabel(\"Débit de dose (mSv / jour, échelle log)\")\n",
    "ax.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Sens inverse : pour chaque tempête NASA (SEP regroupés à moins de 2 jours d'intervalle),\n",
    "# dose maximale mesurée par RAD dans les 3 jours qui suivent, rapportée au fond (médiane)\n",
    "groupes = []\n",
    "for debut in sep_croisiere[\"debut\"]:\n",
    "    if groupes and debut - groupes[-1][-1] <= pd.Timedelta(days=2):\n",
    "        groupes[-1].append(debut)\n",
    "    else:\n",
    "        groupes.append([debut])\n",
    "lignes = []\n",
    "for groupe in groupes:\n",
    "    fenetre = df_rad[\n",
    "        (df_rad[\"utc\"] >= groupe[0]) & (df_rad[\"utc\"] <= groupe[-1] + pd.Timedelta(days=3))\n",
    "    ]\n",
    "    maximum = fenetre[\"dose_msv_day\"].max() if len(fenetre) else float(\"nan\")\n",
    "    lignes.append(\n",
    "        {\n",
    "            \"debut_tempete\": groupe[0].strftime(\"%Y-%m-%d\"),\n",
    "            \"nb_sep\": len(groupe),\n",
    "            \"mesures_rad\": len(fenetre),\n",
    "            \"dose_max_msv_jour\": round(maximum, 2),\n",
    "            \"facteur_vs_fond\": round(maximum / median_dose_msv_day, 2),\n",
    "        }\n",
    "    )\n",
    "df_tempetes = pd.DataFrame(lignes)\n",
    "fortes = (df_tempetes[\"facteur_vs_fond\"] >= 1.5).sum()\n",
    "print(\n",
    "    f\"Tempêtes NASA pendant la croisière : {len(df_tempetes)} ; \"\n",
    "    f\"hausse marquée à bord de Curiosity (≥ 1,5 × le fond) : {fortes}\"\n",
    ")\n",
    "display(df_tempetes)"
   ]
  },
