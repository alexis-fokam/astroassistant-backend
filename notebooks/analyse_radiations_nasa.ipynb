   "source": [
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "# Vue 1 : Échelle complète avec axe Y logarithmique (pour voir la longue traîne des pics solaires)\n",
    "sns.histplot(df_rad[\"dose_msv_day\"], bins=60, color=\"#2b5c8f\", ax=axes[0])\n",
    "axes[0].set_yscale(\"log\")\n",
    "axes[0].axvline(\n",
    "    mean_dose_msv_day, color=\"red\", linestyle=\"--\", label=f\"Moyenne : {mean_dose_msv_day:.2f} mSv/j\"\n",
    ")\n",
    "axes[0].axvline(\n",
    "    median_dose_msv_day,\n",
