   "source": [
    "DUREE_TRANSIT_JOURS = 210\n",
    "LIMITE_NASA_MSV = 600.0\n",
    "\n",
    "# 1. Extrapolation basée sur le débit moyen global (incluant les tempêtes solaires)\n",
    "dose_210j_moyenne = mean_dose_msv_day * DUREE_TRANSIT_JOURS\n",
    "\n",
    "# 2. Intégration trapézoïdale exacte sur la durée réelle du jeu de données, puis mise à l'échelle à 210j\n",
    "duree_reelle_heures = (df_rad[\"utc\"].max() - df_rad[\"utc\"].min()).total_seconds() / 3600\n",
    "# Conversion en heures depuis le début pour intégration numérique\n",
    "heures_ecoulees = (df_rad[\"utc\"] - df_rad[\"utc\"].min()).dt.total_seconds() / 3600\n",
    "dose_totale_observee_msv = np.trapezoid(df_rad[\"dose_equivalent_usv_h\"], heures_ecoulees) / 1000\n",
    "dose_210j_integree = dose_totale_observee_msv * (DUREE_TRANSIT_JOURS * 24 / duree_reelle_heures)\n",
    "\n",
    "pct_limite_moy = (dose_210j_moyenne / LIMITE_NASA_MSV) * 100\n",
    "pct_limite_int = (dose_210j_integree / LIMITE_NASA_MSV) * 100\n",
    "\n",
    "print(\n",
    "    f\"Durée réelle observée : {duree_reelle_heures / 24:.1f} jours (dose intégrée = {dose_totale_observee_msv:.2f} mSv)\"\n",
    ")\n",
    "print(\n",
    "    f\"Dose cumulée extrapolée à 210 jours (via moyenne)     : {dose_210j_moyenne:.2f} mSv ({pct_limite_moy:.1f}% de la limite NASA)\"\n",
    ")\n",
    "print(\n",
    "    f\"Dose cumulée extrapolée à 210 jours (via intégration) : {dose_210j_integree:.2f} mSv ({pct_limite_int:.1f}% de la limite NASA)\"\n",
    ")\n",
    "print(\n",
    "    f\"Aller-retour Mars (420 jours, sans surface)           : {dose_210j_integree * 2:.2f} mSv ({pct_limite_int * 2:.1f}% de la limite NASA)\"\n",
    ")\n",
    "\n",
    "# Graphique comparatif\n",
    "fig, ax = plt.subplots(figsize=(9, 4.5))\n",
    "categories = [\n",
    "    f\"Transit observé\\n({duree_reelle_heures / 24:.0f} jours)\",\n",
    "    \"Aller Terre-Mars\\n(extrapolé 210 jours)\",\n",
    "    \"Aller-Retour\\n(extrapolé 420 jours)\",\n",
    "    \"Limite Carrière\\nNASA (600 mSv)\",\n",
    "]\n",
    "valeurs = [dose_totale_observee_msv, dose_210j_integree, dose_210j_integree * 2, LIMITE_NASA_MSV]\n",
    "couleurs = [\"#4c72b0\", \"#dd8452\", \"#c44e52\", \"#55a868\"]\n",
    "\n",
    "bars = ax.bar(categories, valeurs, color=couleurs, width=0.55)\n",
    "ax.axhline(\n",
    "    LIMITE_NASA_MSV, color=\"#2e7d32\", linestyle=\"--\", linewidth=1.5, label=\"Limite NASA : 600 mSv\"\n",
    ")\n",
    "\n",
    "for bar, val in zip(bars, valeurs):\n",
    "    ax.text(\n",
    "        bar.get_x() + bar.get_width() / 2,\n",
    "        val + 12,\n",
    "        f\"{val:.1f} mSv\\n({val / LIMITE_NASA_MSV * 100:.0f}%)\",\n",
    "        ha=\"center\",\n",
    "        va=\"bottom\",\n",
    "        fontsize=9.5,\n",
    "        fontweight=\"bold\",\n",
    "    )\n",
    "\n",
    "ax.set_ylim(0, LIMITE_NASA_MSV * 1.2)\n",
    "ax.set_ylabel(\"Dose cumulée (mSv)\")\n",
    "ax.set_title(\n",
    "    \"Projection de la dose de radiation sur 210 jours vs Limite de carrière NASA\", fontweight=\"bold\"\n",
    ")\n",
    "ax.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
