    "import json\n",
    "from pathlib import Path\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import seaborn as sns\n",
    "\n",
    "# Configuration esthétique des graphiques\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "plt.rcParams[\"figure.figsize\"] = (12, 5)\n",
    "\n",
    "DATA_DIR = Path(\"../data/nasa\")\n",
    "\n",
    "# 1. Chargement de Curiosity RAD (msl_rad_cruise_dose.csv)\n",
    "df_rad = pd.read_csv(DATA_DIR / \"msl_rad_cruise_dose.csv\")\n",
    "print(\"=== MSL RAD CRUISE DOSE ===\")\n",
    "print(f\"Dimensions : {df_rad.shape}\")\n",
    "print(\"Colonnes :\", df_rad.columns.tolist())\n",
    "display(df_rad.head(3))\n",
    "\n",
    "# 2. Aperçu de NOAA GOES (integral_protons)\n",
    "with open(DATA_DIR / \"goes/integral_protons_20261114.json\", encoding=\"utf-8\") as f:\n",
    "    goes_raw = json.load(f)\n",
    "df_goes = pd.DataFrame(goes_raw)\n",
    "print(\"\\n=== NOAA GOES PROTONS ===\")\n",
    "print(f\"Dimensions : {df_goes.shape}\")\n",
    "print(\"Colonnes :\", df_goes.columns.tolist())\n",
    "display(df_goes.head(3))"
   ]
